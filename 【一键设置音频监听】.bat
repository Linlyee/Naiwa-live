@echo off
chcp 936 >nul
title 声音控制面板 - 快速设置音频隔离
echo ========================================================
echo       音频隔离监听设置 (可选 · 让你耳机也能听到直播间)
echo ========================================================
echo.
echo 正在为你打开 Windows 声音录制控制面板...
echo.
echo 操作指南 (只需配一次，以后全自动):
echo 1. 在弹出的窗口中，找到【CABLE Output】双击打开属性
echo 2. 点击【侦听】标签页
echo 3. 勾选【侦听此设备】
echo 4. 在“通过此设备播放”下拉列表中，选择【你的耳机 / 扬声器】
echo 5. 点击【确定】
echo.
echo 说明：
echo 这样设置后，奶娃的声音会分流到你的耳机里让你听见；
echo 但你电脑玩游戏、看视频、微信聊天的声音依然只走你的耳机，
echo 绝对不会流进 CABLE，直播间完全听不到你的杂音！
echo.
start control mmsys.cpl,,1
pause
